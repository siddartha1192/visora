<#
.SYNOPSIS
    Publishes a local image + caption to a Facebook Page and an
    Instagram Business/Creator account via the Meta Graph API.

.NOTES
    - Facebook: direct local file upload (multipart).
    - Instagram: requires a PUBLIC image URL, so the image is first
      uploaded to imgbb (free API key from https://api.imgbb.com/).
      Replace Get-PublicImageUrl with your own hosting logic if preferred.

    Works on PowerShell 7+ (native -Form multipart) AND Windows
    PowerShell 5.1 (falls back to curl.exe for the Facebook upload).
    Run:  pwsh .\Meta-PhotoPublisher.ps1   (or powershell .\Meta-PhotoPublisher.ps1)
#>

# ============================================================
# CONFIG — fill these in
# ============================================================
$GraphVersion    = "v21.0"

$PageId          = "965381603325389"
$IgUserId        = "17841480000696385"
$PageAccessToken = "EAAWvp9u8sOcBR3eBjcDV9ZAyGrqdmSda0F7ZBiR3mIY7Q8gNZB8dahTBWwVOe0dXjFiiYVIG1G34OLokgj4N9kIP96dl6UDfo8FwkwELGq4V65Tl1wJSt1YbLqpGtbvIfS7oh7x3qeqkZBHZBHRl6Vx5PNZCpzJgGzlBZBJMI1lFlJDK99omBJfvGSL4ctEK3Msc5FK6f1GWM4336QX9u54kJosfpOX119UgCxTclwZD"

# Free key from https://api.imgbb.com/ (only needed for Instagram)
$ImgbbApiKey     = "ee98a226dd9a191122fcdebfac80aa15"

$ImagePath       = "C:\Users\HP\Downloads\crm1.png"
$Caption         = "Manage leads, automate follow-ups, and close more deals — all from one intelligent platform. 🚀 #NeuRagg #SmartCRM #BusinessAutomation #SaaS #LeadManagement #AIforBusiness #SalesAutomation #DigitalTransformation #ScalableGrowth #TechForBusiness"

$PostToFacebook  = $true
$PostToInstagram = $true
# ============================================================

$Base = "https://graph.facebook.com/$GraphVersion"
$ErrorActionPreference = "Stop"

function Get-GraphError {
    param($ErrorRecord)
    try {
        $body = $ErrorRecord.ErrorDetails.Message | ConvertFrom-Json
        return "$($body.error.message) (code $($body.error.code), type $($body.error.type))"
    } catch {
        return $ErrorRecord.Exception.Message
    }
}

# ------------------------------------------------------------
# 1. FACEBOOK — direct local file upload to the Page
# ------------------------------------------------------------
function Publish-ToFacebook {
    param([string]$Path, [string]$Message)

    Write-Host "→ Posting to Facebook Page..." -ForegroundColor Cyan

    if ($PSVersionTable.PSVersion.Major -ge 6) {
        # PowerShell 7+ : native multipart via -Form
        try {
            $form = @{
                source       = Get-Item -LiteralPath $Path
                message      = $Message
                access_token = $PageAccessToken
            }
            $resp = Invoke-RestMethod -Uri "$Base/$PageId/photos" -Method Post -Form $form
        } catch {
            throw "Facebook photo upload failed: $(Get-GraphError $_)"
        }
    }
    else {
        # Windows PowerShell 5.1 : no -Form support, use curl.exe (built into Win10/11)
        $curl = Get-Command curl.exe -ErrorAction SilentlyContinue
        if (-not $curl) {
            throw "Windows PowerShell 5.1 detected and curl.exe not found. Install PowerShell 7 (winget install Microsoft.PowerShell) and run with pwsh."
        }
        $raw = & curl.exe -s -X POST "$Base/$PageId/photos" `
            -F "source=@`"$Path`"" `
            -F "message=$Message" `
            -F "access_token=$PageAccessToken"
        try { $resp = $raw | ConvertFrom-Json } catch { throw "Facebook upload returned unexpected output: $raw" }
        if ($resp.error) {
            throw "Facebook photo upload failed: $($resp.error.message) (code $($resp.error.code), type $($resp.error.type))"
        }
    }

    $postId = if ($resp.post_id) { $resp.post_id } else { $resp.id }
    Write-Host "  ✓ Facebook post published. post_id = $postId" -ForegroundColor Green
    return $resp
}

# ------------------------------------------------------------
# 2a. Get a public URL for the image (Instagram requires this)
#     Uses imgbb via base64 — swap this function for your own
#     server/S3 upload if you prefer.
# ------------------------------------------------------------
function Get-PublicImageUrl {
    param([string]$Path)

    if ([string]::IsNullOrWhiteSpace($ImgbbApiKey) -or $ImgbbApiKey.StartsWith("YOUR_")) {
        throw ("Instagram needs a publicly accessible image URL. " +
               "Set `$ImgbbApiKey (free key from api.imgbb.com) " +
               "or replace Get-PublicImageUrl with your own hosting logic.")
    }

    Write-Host "→ Uploading image to imgbb to get a public URL..." -ForegroundColor Cyan
    $base64 = [Convert]::ToBase64String([IO.File]::ReadAllBytes($Path))

    $resp = Invoke-RestMethod -Uri "https://api.imgbb.com/1/upload?key=$ImgbbApiKey" `
                              -Method Post `
                              -Body @{ image = $base64 }

    if (-not $resp.success) { throw "imgbb upload failed: $($resp | ConvertTo-Json -Depth 5)" }

    $url = $resp.data.url
    Write-Host "  ✓ Public URL: $url" -ForegroundColor Green
    return $url
}

# ------------------------------------------------------------
# 2b. INSTAGRAM — create media container, then publish
# ------------------------------------------------------------
function Publish-ToInstagram {
    param([string]$PublicImageUrl, [string]$Message)

    Write-Host "→ Creating Instagram media container..." -ForegroundColor Cyan
    try {
        $container = Invoke-RestMethod -Uri "$Base/$IgUserId/media" -Method Post -Body @{
            image_url    = $PublicImageUrl
            caption      = $Message
            access_token = $PageAccessToken
        }
    } catch {
        throw "Instagram container creation failed: $(Get-GraphError $_)"
    }
    $creationId = $container.id
    Write-Host "  ✓ Container created: $creationId" -ForegroundColor Green

    Write-Host "→ Publishing Instagram post..." -ForegroundColor Cyan
    try {
        $published = Invoke-RestMethod -Uri "$Base/$IgUserId/media_publish" -Method Post -Body @{
            creation_id  = $creationId
            access_token = $PageAccessToken
        }
    } catch {
        throw "Instagram publish failed: $(Get-GraphError $_)"
    }
    Write-Host "  ✓ Instagram post published. media_id = $($published.id)" -ForegroundColor Green
    return $published
}

# ------------------------------------------------------------
# main
# ------------------------------------------------------------
if (-not (Test-Path -LiteralPath $ImagePath)) {
    throw "Image not found: $ImagePath"
}

if ($PostToFacebook) {
    Publish-ToFacebook -Path $ImagePath -Message $Caption | Out-Null
}

if ($PostToInstagram) {
    $publicUrl = Get-PublicImageUrl -Path $ImagePath
    Publish-ToInstagram -PublicImageUrl $publicUrl -Message $Caption | Out-Null
}

Write-Host "`nDone ✅" -ForegroundColor Green