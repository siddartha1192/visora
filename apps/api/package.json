{
  "name": "@visora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "create-platform-admin": "node dist/cli/create-platform-admin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint placeholder)\"",
    "pretest": "pnpm --filter @visora/shared build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.637.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^6.12.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^0.3.3",
    "@langchain/langgraph": "^0.2.3",
    "@langchain/langgraph-checkpoint-mongodb": "^0.0.3",
    "@langchain/openai": "^0.3.0",
    "@visora/shared": "workspace:*",
    "argon2": "^0.41.1",
    "bullmq": "^5.12.0",
    "cloudinary": "^2.4.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "mongoose": "^8.6.0",
    "openai": "^4.57.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "playwright": "^1.46.1",
    "sharp": "^0.35.3",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
