# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# ── Core infra ───────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/visora
REDIS_URL=redis://localhost:6379

# ── Auth (CHANGE THE SECRET IN PRODUCTION) ───────────────
JWT_SECRET=dev-insecure-secret-change-me-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated emails auto-promoted to root on login. Register the account
# normally first, then log in again after setting this for the promotion to
# apply. Root is the only role that can create admins (via the dashboard) —
# there is no env-var bootstrap for admin, by design.
ROOT_EMAILS=

# ── Storage (S3 / localstack / minio) ────────────────────
# Leave AWS keys blank to use the in-memory store for local dev.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=visora-assets
# For localstack: http://localhost:4566 + path-style
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ── AI / media providers (blank = deterministic stubs) ───
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-4o-mini

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Enable headless-browser scraping (requires `npx playwright install`)
ENABLE_PLAYWRIGHT=false
