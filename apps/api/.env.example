# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# ── Core infra ───────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/visora
REDIS_URL=redis://localhost:6379

# ── Auth (CHANGE THE SECRET IN PRODUCTION) ───────────────
JWT_SECRET=dev-insecure-secret-change-me-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# NOTE: ROOT_EMAILS was removed. It granted platform access on *login* to any
# account matching an env-var list, so whoever registered that address first
# became platform root. Create the SaaS operator account explicitly instead:
#
#   docker exec -it visora-api-1 node dist/cli/create-platform-admin.js
#
# Customer tenants are then provisioned via POST /v1/platform/tenants.

# ── Storage (S3 / localstack / minio) ────────────────────
# Leave AWS keys blank to use the in-memory store for local dev.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=visora-assets
# For localstack: http://localhost:4566 + path-style
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ── AI / media providers (blank = deterministic stubs) ───
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-4o-mini

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Enable headless-browser scraping (requires `npx playwright install`)
ENABLE_PLAYWRIGHT=false

# ── Social publishing (blank = stub publisher, logs instead of posting) ──
# These are the platform-default accounts: every workspace publishes through
# them until it connects its own. Workspace.socialAccounts[] can point a
# workspace at a *different* env var (accessTokenRef) once a real per-tenant
# OAuth connect flow exists — see modules/workspace/publisher-resolver.ts.
# There is no such flow yet, so today every workspace uses these.
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
