# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# ── Core infra ───────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/visora
REDIS_URL=redis://localhost:6379

# ── Auth (CHANGE THE SECRET IN PRODUCTION) ───────────────
JWT_SECRET=dev-insecure-secret-change-me-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# NOTE: ROOT_EMAILS was removed. It granted platform access on *login* to any
# account matching an env-var list, so whoever registered that address first
# became platform root. Create the SaaS operator account explicitly instead:
#
#   docker exec -it visora-api-1 node dist/cli/create-platform-admin.js
#
# Customer tenants are then provisioned via POST /v1/platform/tenants.

# ── Storage (S3 / localstack / minio) ────────────────────
# Leave AWS keys blank to use the in-memory store for local dev.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=visora-assets
# For localstack: http://localhost:4566 + path-style
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ── AI / media providers (blank = deterministic stubs) ───
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-4o-mini

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Enable headless-browser scraping (requires `npx playwright install`)
ENABLE_PLAYWRIGHT=false

# ── Social publishing (blank = stub publisher, logs instead of posting) ──
# These are the platform-default accounts: every workspace publishes through
# them until it connects its own via the Instagram/Facebook Connect flow
# below. LinkedIn has no real connect flow yet — every workspace uses this.
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=

# ── Per-workspace Instagram/Facebook Connect (blank = Connect button errors) ──
# Register an app at developers.facebook.com (the same app can mint the
# INSTAGRAM_ACCESS_TOKEN/FACEBOOK_ACCESS_TOKEN above for your own account).
# redirect_uri must be registered in that app's OAuth settings — an ngrok
# HTTPS tunnel works for local testing; Meta rejects plain http://localhost.
META_APP_ID=
META_APP_SECRET=

# Encrypts customer OAuth tokens at rest (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# CHANGE THIS IN PRODUCTION — losing or rotating it makes every stored token
# permanently undecryptable; back it up like JWT_SECRET, not casually.
TOKEN_ENCRYPTION_KEY=dev-insecure-encryption-key-change-me-please
